-- =========================================================================
-- PRE-NETTOYAGE DES ANCIENNES VERSIONS DE FONCTIONS
-- =========================================================================
DROP FUNCTION IF EXISTS public.central_tarot_orchestrator() CASCADE;
DROP FUNCTION IF EXISTS public.join_or_create_tarot_table(text, text, text) CASCADE;

-- =========================================================================
-- 1. MISE À JOUR DE L'ORCHESTRATEUR CENTRAL (CORRECTION DU TIMER)
-- =========================================================================
CREATE OR REPLACE FUNCTION public.central_tarot_orchestrator()
RETURNS TRIGGER AS $$
BEGIN
    -- Aligne les colonnes de versioning pour éviter tout désaccord avec Dart
    IF NEW.version IS DISTINCT FROM OLD.version THEN
        NEW.game_version := NEW.version::INT;
    ELSIF NEW.game_version IS DISTINCT FROM OLD.game_version THEN
        NEW.version := NEW.game_version::BIGINT;
    END IF;

    -- FIX CHRONO : On ne change le timer QUE si le joueur actif change OU si le statut du jeu bascule.
    -- La simple connexion d'un joueur (changement de playerX_uid ou de version brute) NE DOIT PAS toucher au chrono !
    IF (NEW.current_player_index IS DISTINCT FROM OLD.current_player_index) 
       OR (NEW.game_status IS DISTINCT FROM OLD.game_status) THEN
        NEW.turn_ends_at := NOW() AT TIME ZONE 'UTC' + INTERVAL '30 seconds';
    ELSE
        -- On conserve STRICTEMENT le chronomètre déjà établi pour éviter le reset à l'arrivée du joueur 2
        NEW.turn_ends_at := OLD.turn_ends_at;
    END IF;

    NEW.updated_at := NOW() AT TIME ZONE 'UTC';
    RETURN NEW;
END;
$$ LANGUAGE plpgsql;

-- =========================================================================
-- 2. RECRÉATION DU TRIGGER SUR LA TABLE
-- =========================================================================
DROP TRIGGER IF EXISTS tr_central_tarot ON public.table_tarot_5;
CREATE TRIGGER tr_central_tarot 
    BEFORE UPDATE ON public.table_tarot_5 
    FOR EACH ROW EXECUTE FUNCTION public.central_tarot_orchestrator();

-- =========================================================================
-- 3. MISE À JOUR DE LA FONCTION D'INSCRIPTION (CORRECTION DES CONFLITS)
-- =========================================================================
CREATE OR REPLACE FUNCTION public.join_or_create_tarot_table(
    p_user_id TEXT,
    p_user_name TEXT,
    p_user_avatar TEXT DEFAULT NULL
)
RETURNS TABLE(assigned_table_id TEXT, assigned_slot INTEGER) AS $$
DECLARE
    v_table_id TEXT;
    v_slot INTEGER;
    v_current_ends TIMESTAMP WITH TIME ZONE;
BEGIN
    -- Recherche d'une table active en phase d'enchères non complète
    SELECT table_id, turn_ends_at INTO v_table_id, v_current_ends
    FROM public.table_tarot_5
    WHERE game_status = 'BIDDING'
      AND turn_ends_at > NOW() AT TIME ZONE 'UTC'
      AND (
        (CASE WHEN player0_uid IS NULL THEN 0 ELSE 1 END) +
        (CASE WHEN player1_uid IS NULL THEN 0 ELSE 1 END) +
        (CASE WHEN player2_uid IS NULL THEN 0 ELSE 1 END) +
        (CASE WHEN player3_uid IS NULL THEN 0 ELSE 1 END) +
        (CASE WHEN player4_uid IS NULL THEN 0 ELSE 1 END)
      ) < 5
    ORDER BY created_at DESC
    LIMIT 1
    FOR UPDATE SKIP LOCKED;

    -- Si une table existe, on s'installe sur le premier emplacement libre disponible
    IF v_table_id IS NOT NULL THEN
        IF (SELECT player0_uid FROM public.table_tarot_5 WHERE table_id = v_table_id) IS NULL THEN
            UPDATE public.table_tarot_5 SET player0_uid = p_user_id, player0_name = p_user_name, player0_avatar = p_user_avatar, version = version + 1, phone_index = 'JOIN_0' WHERE table_id = v_table_id; v_slot := 0;
        ELSIF (SELECT player1_uid FROM public.table_tarot_5 WHERE table_id = v_table_id) IS NULL THEN
            UPDATE public.table_tarot_5 SET player1_uid = p_user_id, player1_name = p_user_name, player1_avatar = p_user_avatar, version = version + 1, phone_index = 'JOIN_1' WHERE table_id = v_table_id; v_slot := 1;
        ELSIF (SELECT player2_uid FROM public.table_tarot_5 WHERE table_id = v_table_id) IS NULL THEN
            UPDATE public.table_tarot_5 SET player2_uid = p_user_id, player2_name = p_user_name, player2_avatar = p_user_avatar, version = version + 1, phone_index = 'JOIN_2' WHERE table_id = v_table_id; v_slot := 2;
        ELSIF (SELECT player3_uid FROM public.table_tarot_5 WHERE table_id = v_table_id) IS NULL THEN
            UPDATE public.table_tarot_5 SET player3_uid = p_user_id, player3_name = p_user_name, player3_avatar = p_user_avatar, version = version + 1, phone_index = 'JOIN_3' WHERE table_id = v_table_id; v_slot := 3;
        ELSIF (SELECT player4_uid FROM public.table_tarot_5 WHERE table_id = v_table_id) IS NULL THEN
            UPDATE public.table_tarot_5 SET player4_uid = p_user_id, player4_name = p_user_name, player4_avatar = p_user_avatar, version = version + 1, phone_index = 'JOIN_4' WHERE table_id = v_table_id; v_slot := 4;
        END IF;
    ELSE
        -- Sinon, création de la table par le Joueur 0 (Hôte ALPHA)
        v_table_id := 'table_' || substring(md5(random()::text) from 1 for 8);
        v_slot := 0;
        
        INSERT INTO public.table_tarot_5 (
            table_id, game_status, version, player0_uid, player0_name, player0_avatar, last_action_time, turn_ends_at, phone_index
        ) VALUES (
            v_table_id, 'BIDDING', 1, p_user_id, p_user_name, p_user_avatar, TO_CHAR(NOW() AT TIME ZONE 'UTC', 'YYYY-MM-DD"T"HH24:MI:SS"Z"'), NOW() AT TIME ZONE 'UTC' + INTERVAL '30 seconds', 'INIT'
        );
    END IF;

    RETURN QUERY SELECT v_table_id, v_slot;
END;
$$ LANGUAGE plpgsql;
